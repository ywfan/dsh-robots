  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "exclude": [
    "node_modules",
    "**/lib",
    "**/dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "tests"
  ]
}
